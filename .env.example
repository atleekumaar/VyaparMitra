# VyaparMitra Production Environment Configuration
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
DEMO_MODE=true

# Groq LLM API Key (Ultra-fast LPU inference)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b

# Twilio Credentials for WhatsApp & SMS Notifications
# TWILIO_API_KEY_SID=your_twilio_sid_here
# TWILIO_API_KEY_SECRET=your_twilio_secret_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=+14155238886

# Brevo (Sendinblue) SMTP Relay for Email & OTP Delivery
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your_brevo_login_email@example.com
# BREVO_SMTP_PASSWORD=your_brevo_smtp_master_key_here
# BREVO_SENDER_EMAIL=no-reply@vyaparmitra.com
# BREVO_SENDER_NAME=VyaparMitra Security
# OTP_EXPIRY_MINUTES=10

